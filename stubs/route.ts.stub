import { {{Name}}Controller } from '../../controllers/{{Name}}Controller.ts'

/**
 * {{Name}} routes
 *
 * This file is generated into src/routes/api/, so controller imports go up two
 * levels. The route loader reports an import failure and moves on, which means a
 * wrong path here shows up as a 404 rather than an error.
 */

interface Router {
  get: (path: string, ...handlers: Function[]) => void
  post: (path: string, ...handlers: Function[]) => void
  put: (path: string, ...handlers: Function[]) => void
  delete: (path: string, ...handlers: Function[]) => void
}

export default (router: Router) => {
  router.get('/api/{{pluralLower}}', {{Name}}Controller.index)
  router.get('/api/{{pluralLower}}/:id', {{Name}}Controller.show)
  router.post('/api/{{pluralLower}}', {{Name}}Controller.create)
  router.put('/api/{{pluralLower}}/:id', {{Name}}Controller.update)
  router.delete('/api/{{pluralLower}}/:id', {{Name}}Controller.destroy)
}
