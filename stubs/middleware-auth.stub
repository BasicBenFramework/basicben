/**
 * Auth middleware
 *
 * Verifies the JWT from the Authorization header and populates req.user.
 *
 * Exported by name, not as a default. The framework auto-loads
 * src/middleware/*.js and applies any DEFAULT export to every request — a
 * default-exported auth guard would reject login and registration too. Attach
 * this to the routes that need it instead:
 *
 *   // src/routes/api/posts.js — where make:route generates, so two levels up
 *   import { auth } from '../../middleware/{{lower}}.js'
 *   router.get('/api/posts', auth, PostController.index)
 */

import { verifyJwt } from '@basicbenframework/core/auth'
import { DEFAULT_ROLE } from '@basicbenframework/core/auth/permissions'

export const auth = async (req, res, next) => {
  const authHeader = req.headers.authorization

  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.json({ error: 'No token provided' }, 401)
  }

  const token = authHeader.slice(7) // Remove 'Bearer '

  const payload = verifyJwt(token, process.env.APP_KEY)

  if (!payload) {
    return res.json({ error: 'Invalid or expired token' }, 401)
  }

  req.userId = payload.userId
  // Capability checks read req.user
  req.user = { id: payload.userId, role: payload.role ?? DEFAULT_ROLE }

  next()
}
