/**
 * {{Name}} model
 */

import { db } from '@basicbenframework/core/db'

/**
 * Widen this as columns are added — it is what callers see, so it is worth
 * keeping honest rather than leaving as a record of unknowns.
 */
export interface {{Name}}Record {
  id: number
  created_at?: string
  updated_at?: string
  [column: string]: unknown
}

export const {{Name}} = {
  /**
   * Table name
   */
  table: '{{tableName}}',

  /**
   * Columns that can be mass-assigned.
   * Add column names here to allow them in create/update operations.
   */
  fillable: [
    // 'name',
    // 'email',
  ],

  /**
   * Get all {{pluralLower}}
   */
  all: async () => {
    return (await db.table('{{tableName}}')).get()
  },

  /**
   * Find {{lower}} by ID
   */
  find: async (id: number) => {
    return (await db.table('{{tableName}}')).find(id)
  },

  /**
   * Create a new {{lower}}
   *
   * Uses mass assignment protection - only columns in `fillable` are allowed.
   */
  create: async (data: Partial<{{Name}}Record>) => {
    return (await db.table('{{tableName}}'))
      .only(...{{Name}}.fillable)
      .insert(data)
  },

  /**
   * Update a {{lower}}
   *
   * Uses mass assignment protection - only columns in `fillable` are allowed.
   */
  update: async (id: number, data: Partial<{{Name}}Record>) => {
    return (await db.table('{{tableName}}'))
      .only(...{{Name}}.fillable)
      .where('id', id)
      .update(data)
  },

  /**
   * Delete a {{lower}}
   */
  destroy: async (id: number) => {
    return (await db.table('{{tableName}}'))
      .where('id', id)
      .delete()
  },

  /**
   * Query builder for custom queries.
   *
   * @example
   * const active = await {{Name}}.query().where('active', true).get()
   */
  query: async () => {
    return db.table('{{tableName}}')
  }
}
