# Application
#
# Signs sessions. In production it must be at least 32 characters or the app
# refuses to start; changing it signs everyone out. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_KEY=your-secret-key-here

# Shown in emails, the authenticator-app entry for two-factor, and the passkey
# prompt. Defaults to BasicBen.
# SITE_NAME=My Blog

# Signs webhook deliveries. Separate from APP_KEY on purpose: every webhook
# receiver needs this to verify a delivery, and APP_KEY signs sessions. Without
# it, webhooks are not sent. Generate it the same way as APP_KEY.
# WEBHOOK_SECRET=
#
# In production, webhook URLs on loopback or private addresses are refused, so a
# URL cannot be aimed at the cloud metadata service or an internal host. Set this
# only when the receiver really is on your private network.
# WEBHOOK_ALLOW_PRIVATE=true

# Server Ports
PORT=3001              # API server
VITE_PORT=3000         # Frontend dev server

# Database - uncomment ONE of the following:

# SQLite (default)
DATABASE_URL=./database.sqlite

# Turso / libSQL (hosted SQLite, no local disk needed)
# TURSO_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# PostgreSQL
# DATABASE_URL=postgres://user:pass@localhost:5432/mydb

# Neon (serverless Postgres — uses the postgres driver)
# DATABASE_URL=postgres://user:pass@ep-cool-name.us-east-2.aws.neon.tech/mydb?sslmode=require

# Mail
# Without a provider the console transport prints messages, including the
# verification link, so registration works out of the box in development.
MAIL_FROM=BasicBen <onboarding@resend.dev>
APP_URL=http://localhost:3000

# The public site, when it is not this app (a headless front end). Feed,
# sitemap and robots.txt links are built from this, then APP_URL — never from
# the request's Host header, which the client controls.
# SITE_URL=https://example.com

# Passkeys are bound to a domain, by default APP_URL's hostname. Set the parent
# domain to let one passkey work across subdomains, and list every origin a
# sign-in can come from. Decide before anyone enrols: changing the domain
# invalidates every passkey.
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_ORIGINS=https://example.com,https://admin.example.com

# Resend (uses its SMTP relay — the API key is the password)
# RESEND_API_KEY=re_your_api_key

# Any other SMTP provider, or Mailpit locally:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# Object storage for the media library.
#
# Leave these unset and uploads go to public/uploads, which is fine in
# development and wrong in production — the directory is not the one the built
# app serves, and it does not survive a redeploy on most hosts.
#
# R2, S3, MinIO, B2 and Spaces are the same driver; only endpoint and region
# differ.
# S3_BUCKET=my-blog-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Cloudflare R2
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto

# AWS S3 — omit S3_ENDPOINT and set a real region
# S3_REGION=us-east-1

# MinIO, locally:
#   docker run -d -p 9000:9000 -e MINIO_ROOT_USER=minioadmin \
#     -e MINIO_ROOT_PASSWORD=minioadmin minio/minio server /data
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1

# Serve files through a CDN or custom domain instead of the bucket URL
# S3_PUBLIC_URL=https://cdn.example.com

# Backups (npm run backup -- --s3). Each BACKUP_S3_* left unset falls back to
# the matching S3_* above. Use a separate, private bucket: a backup holds
# personal data (member and commenter emails). See docs/backup.md.
# BACKUP_S3_BUCKET=my-blog-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=

# On a serverless host (Vercel, Lambda) object storage is not optional: the
# filesystem is read-only apart from an ephemeral /tmp, so the local driver
# cannot accept uploads at all. The app warns at boot when it detects that
# combination. Reads are unaffected.

# Responsive images through a resizing CDN. With a template, every image in the
# content API gets a srcset; without one, images still carry their dimensions.
# {url} is the original's absolute URL ({url_encoded} if the service wants it
# encoded), {width} the target width.
#   Cloudflare: https://example.com/cdn-cgi/image/width={width},format=auto/{url}
#   imgix:      {url}?w={width}&auto=format
# IMAGE_TRANSFORM_URL=

# --- Scheduled jobs ------------------------------------------------------------
#
# Core and the features keep their background work in one list: announcing
# scheduled posts that went live, the analytics purge, rate-limit and
# magic-link cleanup, and the newsletter queue. A long-running server runs it
# on an interval by itself. On serverless, point a cron at GET /api/cron/tick:
# each call runs whatever is due. Once a day is enough unless you send
# newsletters through the built-in queue, which wants every minute (or use
# MySendbox below).
#
# The endpoint requires this secret as a bearer token (Vercel Cron sends it
# automatically) and answers 404 while it is unset or wrong. It also guards the
# older single-job routes, /api/cron/publish-due, /api/cron/newsletters and
# /api/cron/maintenance. On Vercel, in vercel.json:
#   "crons": [{ "path": "/api/cron/tick", "schedule": "0 4 * * *" }]
# CRON_SECRET=

# --- Newsletters through MySendbox ---------------------------------------------
#
# With a key, members are copied to MySendbox as contacts and a post sent as a
# newsletter becomes a MySendbox broadcast, instead of the built-in queue (so
# no every-minute cron is needed for newsletters). Its marketing API must be on
# for the workspace. The key needs contacts and broadcasts scopes and no domain
# or mailbox limits. See the mysendbox feature's README in the CMS.
# MYSENDBOX_API_KEY=msb_live_...
#
# The signing secret of a MySendbox webhook for contact.updated and
# contact.erased, pointed at https://<this app>/api/webhooks/mysendbox. Without
# it, unsubscribes made in MySendbox arrive through the daily check instead.
# MYSENDBOX_WEBHOOK_SECRET=whsec_...

# --- Public site ---------------------------------------------------------------
#
# A server-rendered public theme (blog, archives, pages, custom types, feeds of
# OG/SEO tags, oEmbed). Off by default: a headless front end renders the site.
# "ssr" turns it on, "off" forces it off; unset, Settings → Reading → Public
# site decides. DISABLE_PUBLIC_SITE always wins.
# PUBLIC_THEME=ssr

# --- Behind a proxy ------------------------------------------------------------
#
# Only set this when a proxy you control overwrites X-Forwarded-For. The header
# is client-supplied, so trusting it on a directly-exposed server lets anyone
# rotate their apparent address and slip every rate limit.
# TRUST_PROXY=true
#
# Vercel and most single-CDN setups: TRUST_PROXY=1.
#
# Or the number of proxies in front of the app, counted from the right of the
# header, when there is more than one (a CDN in front of a load balancer).
# TRUST_PROXY=2

# --- Importing from WordPress --------------------------------------------------
#
# Used by `basicben-cms import:wordpress`. Read-only against WordPress, and needs
# no credentials for published posts.
# WORDPRESS_URL=https://example.com
#
# To also import drafts, scheduled and private posts, held comments, and
# authors' real email addresses, read as a signed-in user with an application
# password (Users → Profile in WordPress).
# WORDPRESS_AUTH=user:application-password

# --- Importing from Ghost ------------------------------------------------------
#
# Used by `basicben-cms import:ghost`: the site's address, which replaces the
# __GHOST_URL__ placeholder in an export's image links.
# GHOST_URL=https://example.com

# --- Deployment mode -----------------------------------------------------------
#
# Both default to off, which is the full application: a public site, a blog, the
# documentation, and open registration.

# Close registration once your own account exists.
#
# Enforced in the API, not just hidden in the UI. It deliberately does not apply
# when there are no users yet — a fresh deployment with this already set would
# otherwise have no way to create its first admin, locking you out of the site
# you are installing. Once one account exists it is absolute.
# DISABLE_REGISTRATION=true

# Serve no public site: no home page, no built-in blog, no documentation, and no
# feed or sitemap. What remains is signing in and the admin.
#
# This is the mode for running as a backend to something else — the content API
# at /api/v1 is unaffected, which is the point. The client half is compiled in,
# so changing it needs a rebuild.
# DISABLE_PUBLIC_SITE=true
