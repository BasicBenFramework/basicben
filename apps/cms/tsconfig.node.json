{
  "compilerOptions": {
    // A referenced project has to be composite, and a composite project may not
    // disable emit (TS6306/TS6310). Emitting declarations into node_modules
    // keeps `tsc -b` working without leaving build output in the project.
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["vite.config.ts"]
}
