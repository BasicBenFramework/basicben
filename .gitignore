# Test coverage
coverage/

# Database
# The -wal and -shm sidecars carry committed rows not yet in the main file, so
# ignoring only *.sqlite leaks content. WAL is on by default.
*.sqlite
*.sqlite3
*.db
*.sqlite-*
*.db-*

