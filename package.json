{
  "name": "@basicbenframework/cms",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "The BasicBen CMS. Posts, pages, media, an admin UI, and a headless content API.",
  "license": "MIT",
  "exports": {
    "./config": {
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./vite": {
      "types": "./lib/vite.d.ts",
      "default": "./lib/vite.js"
    },
    "./server": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./admin": {
      "types": "./lib/main.d.ts",
      "default": "./lib/main.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "basicben-cms": "./lib/cli/index.mjs"
  },
  "files": [
    "lib",
    "db/migrations",
    "mail",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "site"
  ],
  "scripts": {
    "dev": "npm run build:lib && node scripts/dev.mjs",
    "build": "npm run build:lib && npm run build --workspace site",
    "build:lib": "rm -rf lib && tsc -p tsconfig.build.json && cp src/client/styles.css lib/client/styles.css && chmod +x lib/cli/index.mjs",
    "start": "npm start --workspace site",
    "prepack": "npm run build:lib",
    "test": "cd site && node --test \"../tests/**/*.test.js\" \"../src/features/**/*.test.js\"",
    "migrate": "npm run migrate --workspace site",
    "migrate:status": "npm run migrate:status --workspace site",
    "export": "npm run export --workspace site --",
    "import:json": "npm run import:json --workspace site --",
    "import:wxr": "npm run import:wxr --workspace site --",
    "import:ghost": "npm run import:ghost --workspace site --",
    "import:wordpress": "npm run import:wordpress --workspace site --",
    "backup": "npm run backup --workspace site --",
    "restore": "npm run restore --workspace site --"
  },
  "peerDependencies": {
    "@basicbenframework/core": "^0.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@basicbenframework/core": "^0.8.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.8",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
