{
  "name": "basicben",
  "private": true,
  "type": "module",
  "description": "A CMS you can deploy anywhere, and the framework underneath it.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:cms": "npm run test --workspace @basicben/cms",
    "dev": "npm run dev --workspace @basicben/cms",
    "build": "npm run build --workspace @basicben/cms",
    "smoke": "./scripts/smoke-test.sh",
    "api-reference": "node scripts/generate-api-reference.js"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
