# Application
#
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_KEY=your-secret-key-here

# Server Ports
PORT=3001              # API server
VITE_PORT=3000         # Frontend dev server

# Database - uncomment ONE of the following:

# SQLite (default)
DATABASE_URL=./database.sqlite

# Turso / libSQL (hosted SQLite, no local disk needed)
# TURSO_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# PostgreSQL
# DATABASE_URL=postgres://user:pass@localhost:5432/mydb

# Neon (serverless Postgres — uses the postgres driver)
# DATABASE_URL=postgres://user:pass@ep-cool-name.us-east-2.aws.neon.tech/mydb?sslmode=require

# Mail
# Without a provider the console transport prints messages, including the
# verification link, so registration works out of the box in development.
MAIL_FROM=BasicBen <onboarding@resend.dev>
APP_URL=http://localhost:3000

# Resend (uses its SMTP relay — the API key is the password)
# RESEND_API_KEY=re_your_api_key

# Any other SMTP provider, or Mailpit locally:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# Object storage for the media library.
#
# Leave these unset and uploads go to public/uploads, which is fine in
# development and wrong in production — the directory is not the one the built
# app serves, and it does not survive a redeploy on most hosts.
#
# R2, S3, MinIO, B2 and Spaces are the same driver; only endpoint and region
# differ.
# S3_BUCKET=my-blog-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Cloudflare R2
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto

# AWS S3 — omit S3_ENDPOINT and set a real region
# S3_REGION=us-east-1

# MinIO, locally:
#   docker run -d -p 9000:9000 -e MINIO_ROOT_USER=minioadmin \
#     -e MINIO_ROOT_PASSWORD=minioadmin minio/minio server /data
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1

# Serve files through a CDN or custom domain instead of the bucket URL
# S3_PUBLIC_URL=https://cdn.example.com

# On a serverless host (Vercel, Lambda) object storage is not optional: the
# filesystem is read-only apart from an ephemeral /tmp, so the local driver
# cannot accept uploads at all. The app warns at boot when it detects that
# combination. Reads are unaffected.

# --- Behind a proxy ------------------------------------------------------------
#
# Only set this when a proxy you control overwrites X-Forwarded-For. The header
# is client-supplied, so trusting it on a directly-exposed server lets anyone
# rotate their apparent address and slip every rate limit.
# TRUST_PROXY=true

# --- Importing from WordPress --------------------------------------------------
#
# Used by scripts/import-wordpress.mjs. Read-only against WordPress, and needs
# no credentials for published posts.
# WORDPRESS_URL=https://example.com
