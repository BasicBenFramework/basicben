{
  "name": "Minimal",
  "version": "1.0.0",
  "author": "BasicBen",
  "description": "A deliberately incomplete theme. It replaces the post and archive layouts and inherits everything else, which is the normal way to build a theme — you override what you care about.",
  "settings": {
    "colors": {
      "primary": "#111111",
      "background": "#ffffff",
      "backgroundDark": "#0b0b0b",
      "text": "#111111",
      "textDark": "#f5f5f5",
      "muted": "#6b6b6b",
      "border": "#e5e5e5",
      "borderDark": "#2a2a2a"
    },
    "fonts": {
      "heading": "Georgia, 'Times New Roman', serif",
      "body": "Georgia, 'Times New Roman', serif",
      "mono": "ui-monospace, Menlo, monospace"
    },
    "layout": {
      "maxWidth": "680px",
      "contentWidth": "680px",
      "spacing": "1.75rem",
      "borderRadius": "0"
    },
    "features": {
      "sidebar": false,
      "darkMode": true,
      "tableOfContents": false,
      "socialSharing": false,
      "authorBio": false,
      "relatedPosts": false,
      "comments": true
    }
  }
}
